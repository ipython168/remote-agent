# remote-agent/.gitignore
# ---- ignore all ----
*

# ---- allow root files ----
!.gitignore
!README.md
!pyproject.toml
!.env.example

# ---- allow dirs ----
!*/
!*.py 
!config/
!docs/screenshots

# ---- allow files ----
!config/*.yaml
!docs/screenshots/*.png

# ---- block 呢啲（就算 whitelist 咗都唔要）----
__pycache__/
*.pyc
.ipynb_checkpoints/
*.log
.env
data/history/

